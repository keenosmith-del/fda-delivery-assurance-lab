{
  "name": "@fda/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "cd .. && node --env-file-if-exists=.env backend/dist/backend/src/server.js",
    "worker": "cd .. && node --env-file-if-exists=.env backend/dist/backend/src/workers/run.js"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@types/pg": "8.23.1"
  }
}
