DATABASE_URL=postgresql://fda:fda_local@127.0.0.1:5435/fda_lab
HOST=127.0.0.1
PORT=3000
LAB_ENABLE_FAULTS=true
# LAB_WRITE_TOKEN=replace-with-a-random-secret-at-least-24-characters

# Private hosted deployments require LAB_MODE=staging or production.
# LAB_PUBLIC_ORIGIN=https://replace-with-the-private-staging-host
# LAB_VIEWER_PASSWORD=<generate-a-unique-high-entropy-password>
# LAB_OPERATOR_PASSWORD=<generate-a-different-high-entropy-password>
# LAB_DEMO_PASSWORD=<staging-only-when-faults-are-explicitly-enabled>
# LAB_DATABASE_TLS=verify
# LAB_UI_DIR=frontend/dist
# LAB_DB_POOL_MAX=8

# Optional simulated FDA source. Generate a separate credential (for example openssl rand -hex 32).
# LAB_FDA_TENANT_ID=tenant-001
# LAB_FDA_SOURCE_ID=source-001
# LAB_FDA_SOURCE_TOKEN=<generated-source-token>
# LAB_FDA_PUBLISHER_ORIGIN=http://127.0.0.1:3000

# Optional local synthetic execution. Use a separate disposable simulator database and a dedicated random token.
# LAB_DOWNSTREAM_TOKEN=<generated-downstream-token>
# LAB_DOWNSTREAM_DATABASE_URL=postgresql://fda:fda_local@127.0.0.1:5436/fda_simulator
# LAB_DOWNSTREAM_ORIGIN=http://127.0.0.1:3099
# LAB_DOWNSTREAM_PORT=3099
# LAB_DOWNSTREAM_MAX_ATTEMPTS=3
# LAB_DOWNSTREAM_TEST_FAULT=lost-acknowledgment

# Evidence Investigation can collect deterministic evidence with inference disabled.
LAB_AI_ENABLED=false
# Local inference also requires LAB_WRITE_TOKEN. Hosted use requires separate deployment approval.
# LAB_AI_HOSTED_APPROVED=false
# LAB_AI_PROVIDER=openai
# LAB_AI_MODEL=gpt-5-mini
# LAB_AI_API_KEY=
# LAB_AI_MAX_INPUT_TOKENS=40000
# LAB_AI_MAX_OUTPUT_TOKENS=4000
# LAB_AI_REQUEST_TIMEOUT_MS=12000
